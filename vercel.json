
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/styles/v1/:path*",
      "destination": "/styles/v1/index.html"
    },
    {
      "source": "/styles/v2/:path*",
      "destination": "/styles/v2/index.html"
    },
    {
      "source": "/styles/v3/:path*",
      "destination": "/styles/v3/index.html"
    },
    {
      "source": "/styles/v4/:path*",
      "destination": "/styles/v4/index.html"
    },
    {
      "source": "/styles/v5/:path*",
      "destination": "/styles/v5/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
