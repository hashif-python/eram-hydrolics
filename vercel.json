{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "v1": {
      "root": "designs/v1",
      "framework": "vite"
    },
    "v2": {
      "root": "designs/v2",
      "framework": "vite"
    },
    "v3": {
      "root": "designs/v3",
      "framework": "vite"
    },
    "v4": {
      "root": "designs/v4",
      "framework": "vite"
    },
    "v5": {
      "root": "designs/v5",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}